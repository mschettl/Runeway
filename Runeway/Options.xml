<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Quick commands row: command (Text, from SettingsListElementTemplate) and its description -->
    <Frame name="RunewayCommandRowTemplate" inherits="SettingsListElementTemplate" mixin="RunewayCommandRowMixin" virtual="true">
        <Size x="280" y="26"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Desc" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="CENTER" x="0" y="0"/>
                        <Anchor point="RIGHT" x="-20" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
    <!-- Paragraph row (intro text): wraps over the full width; height from the initializer's GetExtent -->
    <Frame name="RunewayTextRowTemplate" inherits="SettingsListElementTemplate" mixin="RunewayTextRowMixin" virtual="true">
        <Size x="280" y="90"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Body" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP" wordwrap="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="37" y="-8"/>
                        <Anchor point="BOTTOMRIGHT" x="-20" y="4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
